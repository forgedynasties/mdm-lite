<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- All normal (install-time) permissions: no prompt, no Device Owner. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <!-- Keep the background check-in scheduled across reboots (CheckinJob). -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Installed-app inventory (spot vendor-preloaded app stores and the like). A normal
         install-time permission for sideloaded apps; Google Play restricts it, so a
         Play-distributed host would remove it with tools:node="remove". -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />

    <!-- Remote app update (Updater): installing needs "Install unknown apps" allowed for
         the host, granted once at provisioning; until then Android asks on screen. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- Android 12+: without this (a normal install-time permission) PackageInstaller
         ignores USER_ACTION_NOT_REQUIRED and asks on screen even when installs are allowed. -->
    <uses-permission android:name="android.permission.UPDATE_PACKAGES_WITHOUT_USER_ACTION" />
    <!-- Lets the app bring itself back on screen after an update from the background;
         only effective when granted at provisioning (appops SYSTEM_ALERT_WINDOW allow). -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <application>
        <!-- Background check-in every ~15 min while the app is backgrounded or dozing. -->
        <service
            android:name="com.aioapp.mdmlite.CheckinJob"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />
        <!-- Remote "restart app": a no-UI activity in its own process that ends the app's
             process and launches it again (see RestartActivity). -->
        <activity
            android:name="com.aioapp.mdmlite.RestartActivity"
            android:exported="false"
            android:process=":aio_mdm_restart"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />
        <!-- App update: PackageInstaller's result, and relaunch after the replace. -->
        <receiver
            android:name="com.aioapp.mdmlite.Updater$StatusReceiver"
            android:exported="false" />
        <receiver
            android:name="com.aioapp.mdmlite.Updater$ReplacedReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
